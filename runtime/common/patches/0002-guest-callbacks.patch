+/* --- guest callbacks (ARM port) ---
+ * On i386 the game's window/dialog procedures were native code at their VA, so this file could
+ * call them through a function pointer. In the LLASM model a procedure is a translation that
+ * takes the emulated %_cpu and returns by branching to the VA it popped: it can only be entered
+ * through the runtime call-out, which pushes the arguments on the guest stack and runs the guest
+ * until it returns. On i386 the hook is absent and the direct call below is used unchanged. */
+#if defined(__arm__)
+extern int arm_guest_call4(unsigned int proc, unsigned int a, unsigned int b,
+                           unsigned int c, unsigned int d) __attribute__((weak));
+#define GUEST_CALLABLE(p) (arm_guest_call4 != 0)
+#else
+#define GUEST_CALLABLE(p) 0
+#endif
