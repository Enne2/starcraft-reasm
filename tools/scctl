#!/usr/bin/env python3
"""Minimal client for the in-process StarCraft automation socket."""
import argparse
import os
import socket
import sys
import time


def command(sockpath, text, timeout=30.0):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(sockpath)
        s.sendall((text.rstrip("\n") + "\n").encode())
        data = bytearray()
        while not data.endswith(b"\n"):
            part = s.recv(4096)
            if not part:
                raise RuntimeError("socket closed before response")
            data.extend(part)
        reply = data.decode("utf-8", "replace").strip()
        print(reply)
        if reply.startswith("err "):
            raise RuntimeError(reply)
        return reply
    finally:
        s.close()


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--sock", default=os.environ.get("SC_CTL_SOCK", "./sc-ctl.sock"))
    sub = p.add_subparsers(dest="cmd", required=True)
    q = sub.add_parser("shot"); q.add_argument("path")
    q = sub.add_parser("click"); q.add_argument("x", type=int); q.add_argument("y", type=int); q.add_argument("btn", nargs="?", type=int, default=1)
    q = sub.add_parser("move"); q.add_argument("x", type=int); q.add_argument("y", type=int)
    q = sub.add_parser("down"); q.add_argument("x", type=int); q.add_argument("y", type=int); q.add_argument("btn", nargs="?", type=int, default=1)
    q = sub.add_parser("up"); q.add_argument("x", type=int); q.add_argument("y", type=int); q.add_argument("btn", nargs="?", type=int, default=1)
    q = sub.add_parser("key"); q.add_argument("key")
    q = sub.add_parser("keydown"); q.add_argument("key")
    q = sub.add_parser("keyup"); q.add_argument("key")
    q = sub.add_parser("text"); q.add_argument("text")
    sub.add_parser("state")
    q = sub.add_parser("wait"); q.add_argument("seconds", type=float)
    q = sub.add_parser("seq"); q.add_argument("script")
    a = p.parse_args()
    try:
        if a.cmd == "wait": time.sleep(max(0, a.seconds)); return
        if a.cmd == "seq":
            with open(a.script, encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#"):
                        command(a.sock, line)
            return
        args = vars(a)
        if a.cmd in ("shot",): text = f"shot {a.path}"
        elif a.cmd in ("click", "down", "up"): text = f"{a.cmd} {a.x} {a.y} {a.btn}"
        elif a.cmd == "move": text = f"move {a.x} {a.y}"
        elif a.cmd in ("key", "keydown", "keyup"): text = f"{a.cmd} {a.key}"
        elif a.cmd == "text": text = f"text {a.text}"
        else: text = "state"
        command(a.sock, text)
    except (OSError, RuntimeError, UnicodeError) as e:
        print(f"scctl: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
